{
  "servers": {
    "snagit": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "snagit_mcp"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "SNAGIT_MCP_OUTPUT_DIR": "${workspaceFolder}/recordings"
      }
    }
  }
}
